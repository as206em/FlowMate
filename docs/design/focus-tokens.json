{
  "$name": "Focus",
  "$description": "FlowMate design tokens. Light only. Hierarchy from three text tones and weight, structure from hairlines, color from small signals.",
  "color": {
    "surface": {
      "canvas": {
        "value": "#FBFBFA",
        "use": "Window and main content background"
      },
      "sidebar": {
        "value": "#F3F3F1",
        "use": "Sidebar, inspector, sunk areas, code blocks"
      },
      "raised": {
        "value": "#FFFFFF",
        "use": "Panels, cards, fields, menus"
      },
      "hover": {
        "value": "#EEEEEB",
        "use": "Row and button hover"
      },
      "selected": {
        "value": "#E8E8E4",
        "use": "Keyboard-selected row, with a 2px text2 bar on the left"
      },
      "scrim": {
        "value": "rgba(24,24,27,0.14)",
        "use": "Behind the task side panel"
      }
    },
    "text": {
      "primary": {
        "value": "#18181B",
        "use": "Titles, row titles, values"
      },
      "secondary": {
        "value": "#4F4F58",
        "use": "Body copy, inactive controls"
      },
      "tertiary": {
        "value": "#6E6E78",
        "use": "Meta, labels, captions, placeholders"
      }
    },
    "line": {
      "hairline": {
        "value": "rgba(0,0,0,0.08)",
        "use": "Row separators, panel borders"
      },
      "strong": {
        "value": "rgba(0,0,0,0.14)",
        "use": "Buttons, focused fields, menus"
      }
    },
    "signal": {
      "live": {
        "value": "#F0532F",
        "use": "A running timer, and only that. Primary button fill."
      },
      "liveText": {
        "value": "#C93C1B",
        "use": "Live clock text on light surfaces"
      },
      "liveSoft": {
        "value": "rgba(240,83,47,0.08)",
        "use": "Live row tint"
      },
      "liveGlow": {
        "value": "rgba(240,83,47,0.35)",
        "use": "Glow around running rings"
      },
      "onLive": {
        "value": "#1A0A05",
        "use": "Text on the live fill"
      },
      "done": {
        "value": "#6D5AE6",
        "use": "Done status, checked boxes"
      },
      "progress": {
        "value": "#B76E00",
        "use": "In progress status, medium priority"
      },
      "ok": {
        "value": "#15803D",
        "use": "On track"
      },
      "risk": {
        "value": "#DC2626",
        "use": "Overdue, over estimate, high priority"
      },
      "ringTrack": {
        "value": "#E4E4E0",
        "use": "Empty part of every timer ring"
      }
    },
    "status": {
      "todo": {
        "icon": "#6E6E78",
        "fill": "#F1F1EE",
        "text": "#4F4F58",
        "border": "#E2E2DE"
      },
      "inProgress": {
        "icon": "#B76E00",
        "fill": "#FFF4E0",
        "text": "#8A5300",
        "border": "#F3DDB0"
      },
      "done": {
        "icon": "#6D5AE6",
        "fill": "#EFECFD",
        "text": "#4B3BB8",
        "border": "#D9D3F8"
      }
    },
    "priority": {
      "high": {
        "bars": 3,
        "icon": "#DC2626",
        "fill": "#FDECEC",
        "text": "#B91C1C",
        "border": "#F6CFCF"
      },
      "medium": {
        "bars": 2,
        "icon": "#B76E00",
        "fill": "#FFF4E0",
        "text": "#8A5300",
        "border": "#F3DDB0"
      },
      "low": {
        "bars": 1,
        "icon": "#6E6E78",
        "fill": "#F1F1EE",
        "text": "#4F4F58",
        "border": "#E2E2DE"
      }
    },
    "project": {
      "$use": "A project color appears only as a tile: the color at 18% behind the first letter in the full color.",
      "palette": [
        "#FF6B4A",
        "#4EA1F5",
        "#2DBE7A",
        "#E0A020",
        "#8B5CF6",
        "#EC4899",
        "#14B8A6",
        "#64748B"
      ],
      "tileAlpha": 0.18
    },
    "window": {
      "close": "#FF5F57",
      "minimize": "#FEBC2E",
      "zoom": "#28C840"
    }
  },
  "type": {
    "$family": "SF Pro (system). The web reference uses Inter.",
    "taskTitle": {
      "size": 26,
      "weight": 600,
      "tracking": -0.5
    },
    "pageTitle": {
      "size": 20,
      "weight": 600,
      "tracking": -0.3
    },
    "header": {
      "size": 15,
      "weight": 600
    },
    "row": {
      "size": 13.5,
      "weight": 400
    },
    "rowStrong": {
      "size": 13.5,
      "weight": 500,
      "use": "Running task titles"
    },
    "groupTitle": {
      "size": 13.5,
      "weight": 600,
      "use": "Group and board column headings"
    },
    "body": {
      "size": 13.5,
      "weight": 400
    },
    "control": {
      "size": 13,
      "weight": 500
    },
    "meta": {
      "size": 12.5,
      "weight": 400
    },
    "caption": {
      "size": 11,
      "weight": 600,
      "tracking": 0.5,
      "case": "upper"
    },
    "clock": {
      "size": 13,
      "weight": 600,
      "numerals": "tabular"
    },
    "clockLarge": {
      "size": 26,
      "weight": 600,
      "tracking": -0.8,
      "numerals": "tabular"
    },
    "mono": {
      "size": 12.5,
      "family": "SF Mono"
    }
  },
  "space": {
    "1": 2,
    "2": 4,
    "3": 6,
    "4": 8,
    "5": 10,
    "6": 12,
    "7": 14,
    "8": 16,
    "9": 20,
    "10": 24,
    "11": 28,
    "12": 32
  },
  "radius": {
    "tag": 6,
    "control": 7,
    "menuItem": 7,
    "card": 10,
    "panel": 12,
    "pill": 999
  },
  "size": {
    "rowHeight": 46,
    "controlHeight": 30,
    "buttonHeight": 30,
    "tagHeight": 22,
    "sidebarWidth": 240,
    "inspectorWidth": 320,
    "taskPanelWidth": 860,
    "sidePanelWidth": 860,
    "progressBar": 4,
    "swatch": 18,
    "actionBarHeight": 44,
    "toastHeight": 40,
    "bannerMinHeight": 50,
    "quickAddWidth": 520,
    "quickAddFieldHeight": 52,
    "menuWidth": 360,
    "ring": {
      "row": 32,
      "card": 28,
      "menu": 28,
      "large": 150,
      "stroke": 2.5,
      "largeStroke": 8
    }
  },
  "shadow": {
    "none": "none",
    "menu": "0 10px 28px rgba(0,0,0,.14), 0 2px 6px rgba(0,0,0,.06)",
    "sheet": "-18px 0 48px rgba(0,0,0,.12), -2px 0 8px rgba(0,0,0,.04)",
    "selected": "0 1px 2px rgba(0,0,0,.12), 0 0 0 1px rgba(0,0,0,.08)"
  },
  "motion": {
    "hover": "120ms ease-out",
    "menu": "150ms ease-out",
    "sheet": "220ms cubic-bezier(.2,.8,.2,1)",
    "pulse": "1.6s ease-in-out infinite (live dot only)"
  }
}
